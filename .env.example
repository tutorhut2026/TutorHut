# ── Stripe ────────────────────────────────────────────────────────
# Your Stripe secret key (sk_test_... for testing, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secrets — copy from Stripe Dashboard → Webhooks → each endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# ── TutorHut ──────────────────────────────────────────────────────
# The public URL of your Vercel deployment (no trailing slash)
SITE_URL=https://tutorhut.co.uk

# Your Google Apps Script web app URL (from Manage Deployments)
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Introduction fee in pence (1500 = £15.00)
INTRO_FEE_PENCE=1500

# ── Apps Script Properties (set in Apps Script editor, NOT here) ──
# In Apps Script → Project Settings → Script Properties, add:
#   STRIPE_SECRET_KEY     = sk_live_... (same key as above)
#   PLATFORM_FEE_PENCE    = 0  (deducted from transfer; 0 = tutor gets full amount)
#   FIREBASE_SERVICE_ACCOUNT = <full JSON key> (optional, for Auth deletion)
#   TUTORHUT_DOCUMENTS_ROOT_FOLDER_ID = <Drive folder id>
